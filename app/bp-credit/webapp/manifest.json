{
    "_version": "1.65.0",
    "sap.app": {
        "id": "bpcredit",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": {
            "version": "0.1.0"
        },
        "dataSources": {
            "mainService": {
                "uri": "/credit/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {},
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.unified": {},
                "sap.fe.templates": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "bpcredit.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true,
                    "groupId": "$auto"
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "async": true,
                "controlId": "appContent",
                "controlAggregation": "pages",
                "transition": "slide"
            },
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "FilesList",
                    "target": "FilesList"
                },
                {
                    "pattern": "Files({key}):?query:",
                    "name": "FilesDetails",
                    "target": "FilesDetails"
                }
            ],
            "targets": {
                "FilesList": {
                    "type": "Component",
                    "id": "FilesList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "entitySet": "Files",
                            "variantManagement": "Page",
                            "navigation": {
                                "Files": {
                                    "detail": {
                                        "route": "FilesDetails"
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "ResponsiveTable",
                                        "creationMode": "None"
                                    }
                                },
                                "lines/@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "GridTable",
                                        "creationMode": "None"
                                    }
                                }
                            },
                            "content": {
                                "header": {
                                    "actions": {
                                        "importCsv": {
                                            "press": "bpcredit.ext.ImportController.onImport",
                                            "text": "Import CSV",
                                            "visible": true,
                                            "enabled": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "FilesDetails": {
                    "type": "Component",
                    "id": "FilesDetails",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "entitySet": "Files",
                            "navigation": {}
                        }
                    }
                }
            }
        }
    },
    "sap.fe": {}
}
